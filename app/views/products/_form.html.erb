<%= form_with(model: @product, class: "contents") do |form| %>
  <%= render "shared/errors", object: @product %>
  <fieldset class="fieldset">
    <%# The link that opened the form picked the class; only a bare product
        asks. One set of fields per class: two would both post product[size],
        and the empty one, last, would win. %>
    <% if @product.drink? || @product.food? %>
      <%= form.hidden_field :type %>
    <% else %>
      <div class="form-control">
        <%= form.label(:type, "Tipo") %>
        <div class="flex space-x-4 mt-2">
          <%= form.radio_button :type, "Drink" %>
          <%= form.label :type_drink, "Bebida", { class: "ml-2 mr-4" } %>
          <%= form.radio_button :type, "Food" %>
          <%= form.label :type_food, "Comida", { class: "ml-2" } %>
        </div>
      </div>
    <% end %>
    <div class="form-control">
      <%= form.label(:name, "Nome") %>
      <%= form.text_field(:name) %>
    </div>
    <div class="form-control">
      <%= form.label(:code, "Código") %>
      <%= form.text_field(:code) %>
    </div>
    <% if @product.drink? %>
      <div class="form-control">
        <%= form.label(:kind, "Tipo de Bebida") %>
        <%= form.select(:kind, Drink.kinds_select, { include_blank: "Selecione..." }, { class: "form-select" }) %>
      </div>
      <div class="flex space-x-4 my-5">
        <div class="form-control w-1/2">
          <%= form.label(:pack, "Embalagem") %>
          <%= form.select(:pack, Drink.packs_select, { include_blank: "Selecione..." }, { class: "form-select" }) %>
        </div>
        <div class="flex space-x-4 w-1/2">
          <div class="form-control w-1/2">
            <%= form.label(:size, "Tamanho (ml)") %>
            <%= form.number_field(:size) %>
          </div>
          <div class="form-control w-1/2">
            <%= form.label(:acl, "Álcool (%)") %>
            <%= form.number_field(:acl, step: "any") %>
          </div>
        </div>
      </div>
    <% elsif @product.food? %>
      <div class="flex space-x-4 my-5">
        <div class="form-control w-1/2">
          <%= form.label(:kind, "Tipo de Comida") %>
          <%= form.select(:kind, Food.kinds_select, { include_blank: "Selecione..." }, { class: "form-select" }) %>
        </div>
        <div class="form-control w-1/2">
          <%= form.label(:size, "Tamanho (g)") %>
          <%= form.number_field(:size) %>
        </div>
      </div>
    <% end %>
    <div class="form-control">
      <%= form.label(:brand_name) %>
      <%= form.text_field(:brand_name, list: "brand-names", autocomplete: "off",
            data: { search: (search_brands_path(format: :json) if respond_to?(:search_brands_path)) },
            oninput: "suggestBrands(this)") %>
      <datalist id="brand-names"></datalist>
    </div>
    <div class="flex space-x-4 my-5">
      <div class="form-control w-1/2">
        <%= form.label(:quantity) %>
        <%= form.text_field(:quantity, placeholder: "350 ml") %>
      </div>
      <div class="form-control w-1/2">
        <%= form.label(:image) %>
        <%= form.url_field(:image, placeholder: "https://") %>
      </div>
    </div>
    <% if @product.image.present? %>
      <%= tag.img src: @product.image, alt: "", class: "h-24 object-contain" %>
    <% end %>
  </fieldset>
  <div class="inline"><%= form.submit "Salvar", class: "btn btn-primary" %></div>
<% end %>
<% if !@product.new_record? %>
  <%= button_to "Excluir", product_path(@product), method: :delete, class: "btn btn-danger", form: { class: "inline", data: { turbo_confirm: "Tem certeza?" } } %>
<% end %>
<script>
  // The catalogue has more brands than a page could carry, so the names come
  // as someone types: the first 20 that start with what is in the field. A
  // name nobody has yet is fine too: saving the product makes the brand.
  function suggestBrands(input) {
    clearTimeout(input.suggesting);
    input.suggesting = setTimeout(function() {
      const typed = input.value;
      fetch(input.dataset.search + '?q=' + encodeURIComponent(typed), { headers: { Accept: 'application/json' } })
        .then(function(response) { return response.ok ? response.json() : []; })
        .then(function(brands) {
          if (input.value !== typed) return; // a slower answer to an older question
          input.list.replaceChildren(...brands.map(function(brand) { return new Option(brand.name, brand.name); }));
        })
        .catch(function() {});
    }, 200);
  }
</script>
