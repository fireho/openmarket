<turbo-frame id="modal">
  <dialog open id="close_modal" class="popup">
    <% content_for :title, t("openmarket.products.new") %>
    <div class="w-full">
      <h1 class="font-bold text-4xl">
        <% if params[:type] == 'Drink' %>
          <%= t("openmarket.products.new_drink") %>
        <% elsif params[:type] == 'Food' %>
          <%= t("openmarket.products.new_food") %>
        <% else %>
          <%= t("openmarket.products.new") %>
        <% end %>
      </h1>
      <%= render "form" %>
      <%= link_to t("openmarket.products.cancel"), "", data: {
        controller: "modal",
        action: "modal#close"
      }, class: "cancel-button" %>
    </div>
  </dialog>
</turbo-frame>
