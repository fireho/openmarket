<% content_for :title, "Marcas" %>
<div class="w-full">
  <div class="flex justify-between items-center">
    <h1 class="font-bold text-4xl">Marcas</h1>
    <div class="flex space-x-2">
      <%= link_to "Nova Marca", new_brand_path, class: "btn btn-primary" %>
    </div>
  </div>
  <%= form_with url: brands_path, method: :get, class: "mb-4" do |form| %>
    <div class="flex">
      <%= form.text_field :search, value: params[:search], class: "w-full rounded-md border-yellow-300 shadow-sm focus:border-indigo-300 focus:ring focus:ring-indigo-200 focus:ring-opacity-50" %>
      <%= form.submit "Procurar", class: "ml-2 px-4 py-2 bg-gray-600 text-white rounded-md" %>
    </div>
  <% end %>
  <div id="brands" class="min-w-full divide-y divide-gray-200 space-y-5">
    <% if @brands.any? %>
      <% @brands.each do |brand| %>
        <div class="flex flex-col sm:flex-row justify-between items-center pb-5 sm:pb-0">
          <div id="<%= dom_id brand %>" class="w-full sm:w-auto my-5 flex items-center gap-x-4">
            <% if brand.logo.present? %>
              <%= tag.img src: brand.logo, alt: "", loading: "lazy", class: "w-12 h-12 object-contain" %>
            <% end %>
            <div>
              <h2 class="font-bold text-2xl"><%= link_to brand.name, brand %></h2>
              <small class="text-gray-500"><%= [ brand.country, brand.info ].compact_blank.join(" · ") %></small>
            </div>
          </div>
          <div class="w-full sm:w-auto flex flex-col sm:flex-row space-x-2 space-y-2">
            <%= link_to "Editar", edit_brand_path(brand), class: "btn btn-outline" %>
          </div>
        </div>
      <% end %>
    <% else %>
      <p class="text-center my-10">Nenhuma marca encontrada...</p>
    <% end %>
  </div>
  <div class="mt-4">
    <%== pagy_nav(@pagy) if defined?(pagy_nav) %>
  </div>
  <div class="mt-4">
    <p class="text-gray-500 text-sm">
      <%= params[:search].present? ? "Encontradas" : "Total de marcas" %>: <%= @pagy.count %>
    </p>
  </div>
</div>
